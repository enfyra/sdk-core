{
  "name": "@enfyra/sdk-core",
  "version": "0.1.6",
  "description": "Core API client for Enfyra",
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "test": "vitest run",
    "dev:playground": "vite playground",
    "build:playground": "vite build playground",
    "typecheck": "tsc --noEmit && yarn typecheck:playground",
    "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "axios": "^1.19.0",
    "typescript": "^5.8.2",
    "unbuild": "^3.5.0",
    "vite": "7.3.1",
    "vitest": "^3.0.9"
  }
}
